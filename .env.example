# ITC AI Assistant — configuration reference
#
# These values are examples/placeholders for reference.
# The exported n8n workflows do NOT automatically load this file.
# Create the corresponding credentials inside your self-hosted n8n instance.

# Public n8n URL (HTTPS is required for production webhooks)
N8N_PUBLIC_URL=https://n8n.your-domain.com

# Google Gemini — chat model and error diagnosis
GEMINI_API_KEY=your_gemini_api_key

# OpenAI — embeddings for the Supabase vector store
OPENAI_API_KEY=your_openai_api_key

# Supabase — vector database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL — chat memory and error logs
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSL=true

# Telegram — knowledge-base ingestion and error notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_CHAT_ID=your_telegram_chat_id
