    {
      "parameters": {
        "jsCode": "const input = $json;\n\nconst execution = input.execution || {};\nconst error = execution.error || {};\nconst node = error.node || {};\nconst workflow = input.workflow || {};\n\n// تحويل الوقت من milliseconds إلى صيغة تاريخ وقاقعية\nconst timestamp = error.timestamp ? new Date(error.timestamp).toLocaleString('fr-FR', { timeZone: 'Africa/Algiers' }) : new Date().toLocaleString('fr-FR', { timeZone: 'Africa/Algiers' });\n\nreturn [{\n  json: {\n    workflowName: workflow.name || 'غير محدد',\n    workflowId: workflow.id || '',\n    executionId: execution.id || '',\n    executionUrl: execution.url || '',\n    failedNodeName: node.name || execution.lastNodeExecuted || 'غير محدد',\n    failedNodeType: node.type || 'غير محدد',\n    errorMessage: error.message || 'لا توجد رسالة خطأ',\n    stackTrace: error.stack || 'لا يوجد Stack Trace',\n    executionMode: execution.mode || 'unknown',\n    occurredAt: timestamp\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
